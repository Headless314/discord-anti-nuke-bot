DISCORD_TOKEN=your_bot_token_here
OWNER_USER_ID=
LOG_CHANNEL_ID=
COMMAND_PREFIX=>
NUKE_WINDOW_MS=30000
AUTO_BACKUP_ON_RISK=true
CHANNEL_DELETE_THRESHOLD=5
CHANNEL_CREATE_THRESHOLD=5
ROLE_DELETE_THRESHOLD=5
ROLE_CREATE_THRESHOLD=5
KICK_THRESHOLD=10
BAN_THRESHOLD=10
# Discord user ID that receives owner DM logs and can change whitelists. Blank uses each server owner.
# Comma-separated Discord user IDs that should never trigger anti-nuke action.
TRUSTED_USER_IDS=
DASHBOARD_PORT=3000
# Optional: provide a stable private access token. If blank, one is generated on each start.
DASHBOARD_TOKEN=
# Required second factor for the web dashboard. Keep this secret and use 12+ characters.
DASHBOARD_PASSWORD=
# Public URL or hostname/IP for the dashboard. On Bot Hosting, expose DASHBOARD_PORT and set this to the linked URL.
# A hostname/IP here is automatically formatted as http://host:DASHBOARD_PORT/dashboard/.
# Optional override; defaults to https://a19nivomrr.apps.bot-hosting.cloud
DASHBOARD_PUBLIC_URL=
DASHBOARD_PUBLIC_HOST=
# Optional: public protocol/port are represented by DASHBOARD_PUBLIC_URL or DASHBOARD_PUBLIC_HOST.
