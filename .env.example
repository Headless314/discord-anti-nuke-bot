DISCORD_TOKEN=your_bot_token_here
OWNER_USER_ID=
LOG_CHANNEL_ID=
# Startup default; the server owner can change it at runtime with >prefix x.
COMMAND_PREFIX=>
# Optional marker shown before every command in the help screen.
HELP_COMMAND_ICON=🙏🏻
# Edit this file to replace the help ASCII art.
HELP_BANNER_FILE=help-banner.txt
# Optional inline override; use \n for line breaks.
HELP_BANNER=
# Delete the user's command and the bot's response after 30 seconds.
COMMAND_AUTO_DELETE_MS=30000
NUKE_WINDOW_MS=30000
AUTO_BACKUP_ON_RISK=true
CHANNEL_DELETE_THRESHOLD=5
CHANNEL_CREATE_THRESHOLD=5
ROLE_DELETE_THRESHOLD=5
ROLE_CREATE_THRESHOLD=5
KICK_THRESHOLD=10
BAN_THRESHOLD=10
# Discord user ID that receives owner DM logs and can change whitelists. Blank uses each server owner.
# Comma-separated Discord user IDs that should never trigger anti-nuke action.
TRUSTED_USER_IDS=
# Railway provides PORT and Bot Hosting provides SERVER_PORT; either takes priority over this fallback.
DASHBOARD_PORT=3000
# Optional: provide a stable private access token. If blank, one is generated on each start.
DASHBOARD_TOKEN=
# Leave off for a public dashboard protected by DASHBOARD_PASSWORD only.
# Turn on to require the private access token as a second access gate.
DASHBOARD_REQUIRE_TOKEN=off
# Required second factor for the web dashboard. Keep this secret and use 12+ characters.
DASHBOARD_PASSWORD=
# Public URL or hostname/IP for the dashboard. On Bot Hosting, expose DASHBOARD_PORT
# and set this to the public app URL, not the bot-hosting.net control-panel URL.
# A hostname/IP here is automatically formatted as http://host:DASHBOARD_PORT/dashboard/.
# Example: https://your-public-app.apps.bot-hosting.cloud
DASHBOARD_PUBLIC_URL=
DASHBOARD_PUBLIC_HOST=
# Railway sets this when the service has a public domain.
RAILWAY_PUBLIC_DOMAIN=
# Optional: public protocol/port are represented by DASHBOARD_PUBLIC_URL or DASHBOARD_PUBLIC_HOST.
# Cloudflare Quick Tunnel is enabled by default; set this to off only to disable it.
# The dashboard link printed in the console still requires DASHBOARD_PASSWORD.
CLOUDFLARE_TUNNEL=on
# Optional path to the cloudflared executable; defaults to cloudflared on PATH.
# Optional absolute path to cloudflared. Leave blank to use the package/npx fallback.
# CLOUDFLARED_BIN=
